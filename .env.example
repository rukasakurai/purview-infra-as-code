# Azure Developer CLI Environment Variables
# This file shows available configuration options for this project.
# Copy this to .azure/{env-name}/.env and customize as needed.

# Required: Set automatically by azd init
AZURE_ENV_NAME=dev
AZURE_LOCATION=eastus
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: Set automatically by azd auth login
# Remove or leave empty if you want azd to auto-detect
AZURE_PRINCIPAL_ID=

# Optional: Custom Purview account name
# If not set, a unique name will be generated: purview-{uniqueString}
# Must be globally unique, 3-63 characters, lowercase alphanumeric only
#PURVIEW_ACCOUNT_NAME=my-custom-purview-account

# Optional: Custom managed resource group name
# Default: managed-rg-{purviewAccountName}
#PURVIEW_MANAGED_RESOURCE_GROUP_NAME=my-managed-rg

# Optional: Public network access (Enabled or Disabled)
# Default: Enabled
#PURVIEW_PUBLIC_NETWORK_ACCESS=Enabled

# Notes:
# - Lines starting with # are comments and ignored
# - Variables prefixed with AZURE_ are azd conventions
# - Custom variables can be referenced in Bicep via main.parameters.json
# - Never commit .env files with real values (they're in .gitignore)
